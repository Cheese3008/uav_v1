<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ring_detector</name>
  <version>0.0.1</version>
  <description>Ring detector using OpenCV with direct Gazebo Transport input</description>

  <maintainer email="you@example.com">your_name</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>

  <build_depend>protobuf</build_depend>
  <exec_depend>protobuf</exec_depend>

  <build_depend>gz-transport13</build_depend>
  <exec_depend>gz-transport13</exec_depend>

  <build_depend>gz-msgs10</build_depend>
  <exec_depend>gz-msgs10</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>