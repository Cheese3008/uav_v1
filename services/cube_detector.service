[Unit]
Description=cube_detector ROS2 Node
After=microxrce-agent.service

[Service]
Type=simple
User=pihuy
WorkingDirectory=/home/pihuy/tracktor-beam
ExecStart=/bin/bash /home/pihuy/tracktor-beam/services/run_cube_detector.sh
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=ROS_DOMAIN_ID=0
Environment=RMW_FASTRTPS_USE_SHM=0
Environment=HOME=/home/pihuy

[Install]
WantedBy=multi-user.target

